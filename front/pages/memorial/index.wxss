.memorial-container {
  min-height: 100vh;
  background: #fafafa;
  padding: 20px;
  box-sizing: border-box;
}

/* 顶部成员信息 */
.memorial-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  margin-bottom: 30px;
}

.header-photo {
  width: 100px;
  height: 100px;
  margin-bottom: 16px;
  position: relative;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  filter: grayscale(20%); /* 轻微灰度，保持静默感 */
  border: 2px solid #e0e0e0;
}

.member-name {
  font-size: 24px;
  font-weight: 500;
  color: #666;
  margin-bottom: 8px;
}

.member-dates {
  font-size: 14px;
  color: #999;
}

/* 功能区 */
.memorial-actions {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40px;
  padding: 0 20px;
}

.action-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  background: #fff;
  border-radius: 12px;
  flex: 1;
  margin: 0 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.action-item.disabled {
  opacity: 0.5;
}

.action-icon {
  font-size: 32px;
  margin-bottom: 8px;
}

.action-text {
  font-size: 14px;
  color: #666;
}

.disabled-tag {
  position: absolute;
  top: 8px;
  right: 8px;
  font-size: 10px;
  color: #999;
  background: #f0f0f0;
  padding: 2px 6px;
  border-radius: 8px;
}

/* 留言列表 */
.messages-section {
  margin-bottom: 40px;
}

.section-title {
  font-size: 18px;
  font-weight: 500;
  color: #666;
  margin-bottom: 16px;
}

.messages-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.message-item {
  background: #fff;
  padding: 16px;
  border-radius: 12px;
  border-left: 3px solid #ddd;
}

.message-time {
  display: block;
  font-size: 12px;
  color: #999;
  margin-bottom: 8px;
}

.message-content {
  display: block;
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.empty-messages {
  padding: 60px 20px;
  text-align: center;
}

.empty-text {
  font-size: 14px;
  color: #ccc;
}

/* 底部文案 */
.memorial-footer {
  position: fixed;
  bottom: 20px;
  left: 0;
  right: 0;
  text-align: center;
  padding: 20px;
}

.footer-text {
  font-size: 14px;
  color: #999;
  line-height: 1.8;
}
