.index-container {
  min-height: 100vh;
  background: #f8f8f8;
  padding: 20px;
  box-sizing: border-box;
}

/* 问候区域 */
.greeting-section {
  margin-bottom: 30px;
}

.greeting-text {
  display: block;
  font-size: 28px;
  font-weight: bold;
  color: #333;
  margin-bottom: 8px;
}

.greeting-desc {
  display: block;
  font-size: 14px;
  color: #999;
}

/* 核心功能网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-bottom: 30px;
}

.feature-card {
  background: #fff;
  border-radius: 16px;
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.feature-card:active {
  transform: scale(0.95);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}

.feature-icon {
  font-size: 40px;
  margin-bottom: 12px;
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe8e8 0%, #fff0f0 100%);
}

.hug-icon {
  background: linear-gradient(135deg, #ffe8e8 0%, #fff0f0 100%);
}

.safety-icon {
  background: linear-gradient(135deg, #e8f4ff 0%, #f0f8ff 100%);
}

.memorial-icon {
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
}

.echo-icon {
  background: linear-gradient(135deg, #fff0e8 0%, #fff8f0 100%);
}

.feature-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.feature-desc {
  font-size: 12px;
  color: #999;
}

/* 加载状态 */
.loading-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 0;
}

/* 成员区域 */
.members-section {
  margin-top: 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.add-member-btn {
  display: flex;
  align-items: center;
  padding: 6px 16px;
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  border-radius: 20px;
  box-shadow: 0 2px 8px rgba(255, 106, 136, 0.3);
}

.add-icon {
  font-size: 18px;
  color: #fff;
  margin-right: 4px;
  font-weight: bold;
}

.add-text {
  font-size: 14px;
  color: #fff;
  font-weight: 500;
}

/* 成员列表 */
.members-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.member-item {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.member-item:active {
  transform: scale(0.98);
  background: #fafafa;
}

/* 成员头像（简化版） */
.member-avatar-small {
  position: relative;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 18px;
  font-weight: bold;
  color: #fff;
}

/* 状态指示点 */
.status-dot {
  position: absolute;
  bottom: 2px;
  right: 2px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid #fff;
}

.status-dot.alive {
  background: #4caf50;
}

.status-dot.deceased {
  background: #999;
}

/* 成员文字信息 */
.member-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name-text {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.member-nickname-text {
  font-size: 13px;
  color: #999;
}

/* 删除按钮 */
.delete-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  transition: all 0.2s;
}

.delete-btn:active {
  background: #ffebee;
}

.delete-icon {
  font-size: 20px;
  opacity: 0.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
  background: #fff;
  border-radius: 16px;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
  opacity: 0.6;
}

.empty-text {
  font-size: 15px;
  color: #666;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 13px;
  color: #999;
}
