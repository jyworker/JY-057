@import '/styles/common.wxss';

.member-add-container {
  min-height: 100vh;
  padding: 24rpx 0 120rpx;
  box-sizing: border-box;
}

.form-section {
  margin-bottom: 48rpx;
}

.status-section {
  padding: 32rpx 32rpx 0;
}

.status-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.status-options {
  display: flex;
  gap: 24rpx;
}

.status-option {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  font-size: 28rpx;
  color: #666;
}

.status-option.active {
  border-color: #07c160;
  color: #07c160;
  background: rgba(7, 193, 96, 0.06);
}

.submit-section {
  padding: 0 32rpx;
}

.submit-btn {
  margin-top: 24rpx;
}
