.login-container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-content {
  width: 100%;
  padding: 40px;
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 60px;
}

.logo {
  width: 120px;
  height: 120px;
  margin-bottom: 20px;
}

.app-name {
  display: block;
  font-size: 32px;
  font-weight: bold;
  color: #333;
  margin-bottom: 8px;
}

.app-slogan {
  display: block;
  font-size: 16px;
  color: #666;
}

/* 描述文字 */
.description {
  text-align: center;
  margin-bottom: 80px;
}

.desc-text {
  font-size: 14px;
  color: #999;
  letter-spacing: 1px;
}

/* 登录按钮 */
.button-section {
  margin-bottom: 30px;
}

.login-button {
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  border: none;
  font-size: 16px;
  font-weight: 500;
  height: 50px;
  line-height: 50px;
}

/* 隐私协议 */
.privacy-section {
  text-align: center;
}

.privacy-text {
  font-size: 12px;
  color: #999;
}

.privacy-link {
  font-size: 12px;
  color: #ff6a88;
}
