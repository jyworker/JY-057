<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hugmom.back.mapper.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.hugmom.back.entity.User">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="openid" property="openid"/>
        <result column="unionid" property="unionid"/>
        <result column="nick_name" property="nickName"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="phone_number" property="phoneNumber"/>
        <result column="emotion_highlight" property="emotionHighlight"/>
        <result column="vibration" property="vibration"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, user_id, openid, unionid, nick_name, avatar_url, 
        phone_number, emotion_highlight, vibration, create_time, update_time
    </sql>

    <!-- 根据用户ID查询用户 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM hm_user
        WHERE user_id = #{userId}
    </select>

    <!-- 根据OpenID查询用户 -->
    <select id="selectByOpenid" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM hm_user
        WHERE openid = #{openid}
    </select>

    <!-- 插入用户 -->
    <insert id="insert" parameterType="com.hugmom.back.entity.User">
        INSERT INTO hm_user (
            user_id, openid, unionid, nick_name, avatar_url,
            phone_number, emotion_highlight, vibration, create_time, update_time
        ) VALUES (
            #{userId}, #{openid}, #{unionid}, #{nickName}, #{avatarUrl},
            #{phoneNumber}, #{emotionHighlight}, #{vibration}, NOW(), NOW()
        )
    </insert>

    <!-- 更新用户信息 -->
    <update id="updateByUserId" parameterType="com.hugmom.back.entity.User">
        UPDATE hm_user
        <set>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="phoneNumber != null">phone_number = #{phoneNumber},</if>
            update_time = NOW()
        </set>
        WHERE user_id = #{userId}
    </update>

    <!-- 更新用户设置 -->
    <update id="updateSettings">
        UPDATE hm_user
        SET emotion_highlight = #{emotionHighlight},
            vibration = #{vibration},
            update_time = NOW()
        WHERE user_id = #{userId}
    </update>

</mapper>
